<?xml version="1.0" encoding="utf-8"?>
<!-- relacionan los Schemas a utilizar y se configura la pantalla de fondo-->
<!--se usa ScrollView para navegar en pantalla horizontal por la APP-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/imagen_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
        <!--Logo-->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="125dp"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="Logo Universidad"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_u2" />

        <!--Se crea la tarjeta para enviar el mensaje-->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#99FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Título del formulario -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enviar Mensaje"
                    android:textColor="#1A2530"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Configuracion campo de entrada, usando material design -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Escribe tu mensaje aquí...">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/Lin_Mensaje"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón principal -->
                <Button
                    android:id="@+id/btnEnviar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#1A5FA3"
                    android:text="Enviar" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tarjeta para mostrar el estado -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#99FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/Estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado: Esperando respuesta..."
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!--Boton para salir de la aplicacion-->
        <Button
            android:id="@+id/btnSalir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CERRAR APP"
            android:backgroundTint="#FF0000"
            android:layout_marginTop="54dp" />
    </LinearLayout>
</ScrollView>